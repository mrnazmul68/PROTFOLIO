# Public site URL used for metadata, canonicals, sitemap and social share links.
NEXT_PUBLIC_SITE_URL=https://your-domain.com

# Resend API key. Never expose this in the browser.
RESEND_API_KEY=

# A verified Resend sender, e.g. "Nazmul <contact@your-domain.com>".
CONTACT_FROM_EMAIL=

# Optional: where contact emails should be delivered. Defaults to siteConfig.email.
CONTACT_TO_EMAIL=

